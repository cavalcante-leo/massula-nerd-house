# Copie para .env e preencha. Nunca versione o .env.

# --- Servidor ---
PORT=3000
# Fora de NODE_ENV=development|test (inclusive sem NODE_ENV) a API não sobe com este placeholder nem com menos de 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h
# Origens permitidas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# --- Banco ---
# Local (docker compose): postgresql://mnhuser:senha@localhost:5432/massula_nerd_house
# Supabase (Render): session pooler, porta 5432
#   postgresql://postgres.<ref>:<senha>@<host-do-pooler>.pooler.supabase.com:5432/postgres
#   (copie de Connect > Session pooler no painel)
DATABASE_URL=postgresql://mnhuser:senha@localhost:5432/massula_nerd_house

# Opcional: URL usada só por migrations/seeders. Sem ela, usa DATABASE_URL.
# Nunca aponte para o transaction pooler (porta 6543): o CLI recusa.
# DIRECT_URL=

# SSL: obrigatório no Supabase. A CA (Database Settings > SSL) vai em DB_SSL_CA,
# conteúdo PEM em uma linha com "\n" literais.
# DB_SSL=true
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Pool (padrões para servidor contínuo; em serverless use DB_POOL_MAX=2)
# DB_POOL_MAX=5
# DB_POOL_MIN=0

# --- Seed do superadmin (use só ao rodar `npm run db:seed` e remova depois) ---
# SEED_SUPERADMIN_NOME=
# SEED_SUPERADMIN_USUARIO=
# SEED_SUPERADMIN_SENHA=
